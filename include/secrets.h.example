// Copy to include/secrets.h and fill in. That file is gitignored; this one is
// the template and must never hold real values.
//
// config.h includes secrets.h only if it exists (__has_include) and every
// macro here has a safe default there, so a checkout without this file still
// builds — it just cannot associate or post.
#pragma once

#define WIFI_SSID       "YourNetwork"
#define WIFI_PASSWORD   "YourPassword"

// From @BotFather. Treat as a credential: anyone holding it can post as this
// bot and read whatever the bot can see.
#define TELEGRAM_TOKEN  "123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

// Negative for a group or channel. To find it: message the bot, then open
//   https://api.telegram.org/bot<token>/getUpdates
// and read message.chat.id.
#define TELEGRAM_CHAT_ID "123456789"

// Optional. Prefixed to every caption — useful when several nodes report into
// the same chat.
#define TELEGRAM_CAPTION_PREFIX "north gate"

// Optional. The deployment-mode access point (see config.h). Anyone who joins
// it gets the live preview, so give it a real password: WPA2 needs 8..63
// characters. config.h's defaults apply to whichever of these is left out.
#define DEPLOY_AP_SSID      "CAM-SETUP"
#define DEPLOY_AP_PASSWORD  "YourSetupPassword"
